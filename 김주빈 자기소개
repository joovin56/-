            // Hero details fade-in
            gsap.to("#hero-text", {
                opacity: 1,
                y: 0,
                duration: 1,
                ease: "power3.out",
                delay: 0.2
            });

            gsap.to("#hero-image-box", {
                opacity: 1,
                y: 0,
                duration: 1,
                ease: "power3.out",
                delay: 0.4
            });

            // Smooth reveal animation on scroll for all other sections
            const reveals = gsap.utils.toArray('.gsap-reveal');
            reveals.forEach(el => {
                gsap.fromTo(el, 
                    { opacity: 0, y: 50 },
                    {
                        opacity: 1,
                        y: 0,
                        duration: 1.2,
                        ease: "power2.out",
                        scrollTrigger: {
                            trigger: el,
                            start: "top 80%",
                            toggleActions: "play none none none"
                        }
                    }
                );
            });
        });

        // 2. Toast Utility
        const toastEl = document.getElementById('toast');
        const toastMsgEl = document.getElementById('toast-message');

        function showToast(message) {
            toastMsgEl.textContent = message;
            toastEl.classList.remove('translate-y-24', 'opacity-0', 'pointer-events-none');
            toastEl.classList.add('translate-y-0', 'opacity-100');
            setTimeout(() => {
                toastEl.classList.remove('translate-y-0', 'opacity-100');
                toastEl.classList.add('translate-y-24', 'opacity-0', 'pointer-events-none');
            }, 3000);
        }

        // 3. Future Compound Interest Calculator Engine
        window.calculateCompound = function() {
            const seed = parseFloat(document.getElementById('calc-seed').value) || 0;
            const rate = parseFloat(document.getElementById('calc-rate').value) || 0;
            const years = parseInt(document.getElementById('calc-years').value) || 0;

            if (seed <= 0 || rate <= 0 || years <= 0) {
                showToast("모든 입력값을 1보다 크게 설정해줘!");
                return;
            }

            // A = P(1 + r)^t
            const finalVal = seed * Math.pow((1 + (rate / 100)), years);
            const formattedVal = Math.round(finalVal).toLocaleString('ko-KR');
            
            document.getElementById('calc-result-val').textContent = `${formattedVal} 원`;
            showToast("미래 복리 분석 성공! 꾸준함의 힘을 믿어봐 📈");
        }

        // 4. Community Portfolio Showcase Engine
        const defaultPortfolios = [
            {
                id: 101,
                author: "용감한이십대",
                style: "🇺🇸 미국주식 성장 위주",
                assets: [
                    { name: "테슬라 (TSLA)", pct: 60, color: "bg-red-500" },
                    { name: "엔비디아 (NVDA)", pct: 30, color: "bg-amber-500" },
                    { name: "현금 (CMA)", pct: 10, color: "bg-emerald-500" }
                ],
                date: "2026-06-02 11:30"
            },
            {
                id: 102,
                author: "배당수집가",
                style: "💵 안전한 미국 배당주",
                assets: [
                    { name: "리얼티인컴 (O)", pct: 40, color: "bg-blue-600" },
                    { name: "SCHD", pct: 40, color: "bg-indigo-500" },
                    { name: "S&P500 ETF", pct: 20, color: "bg-violet-500" }
                ],
                date: "2026-06-02 12:15"
            },
            {
                id: 103,
                author: "국장생존자",
                style: "🇰🇷 국장 든든 우량주",
                assets: [
                    { name: "삼성전자", pct: 50, color: "bg-cyan-600" },
                    { name: "현대차", pct: 30, color: "bg-slate-700" },
                    { name: "현금", pct: 20, color: "bg-emerald-500" }
                ],
                date: "2026-06-02 15:40"
            }
        ];

        function getPortfolios() {
            const data = localStorage.getItem('jubin_portfolios');
            if (!data) {
                localStorage.setItem('jubin_portfolios', JSON.stringify(defaultPortfolios));
                return defaultPortfolios;
            }
            return JSON.parse(data);
        }

        function renderPortfolios() {
            const container = document.getElementById('portfolio-feed-container');
            const totalCountEl = document.getElementById('pf-total-count');
            const list = getPortfolios();
            
            container.innerHTML = '';
            totalCountEl.textContent = `${list.length}개 등록됨`;

            if (list.length === 0) {
                container.innerHTML = `<div class="text-center py-12 text-slate-400 text-xs">포트폴리오가 아직 없습니다. 1호 등록자가 되어주세요!</div>`;
                return;
            }

            // Newest first
            [...list].reverse().forEach(pf => {
                const card = document.createElement('div');
                card.className = 'p-6 bg-white border border-slate-100 rounded-3xl shadow-sm hover:shadow-md transition-shadow relative group';
                
                // Construct progress bar segments
                let progressSegments = '';
                let legendList = '';
                
                pf.assets.forEach(asset => {
                    if (asset.pct > 0) {
                        progressSegments += `<div class="h-full ${asset.color || 'bg-slate-500'}" style="width: ${asset.pct}%" title="${asset.name}: ${asset.pct}%"></div>`;
                        legendList += `
                            <div class="flex items-center justify-between text-[11px] text-slate-600">
                                <div class="flex items-center gap-1.5">
                                    <span class="w-2.5 h-2.5 rounded-full ${asset.color || 'bg-slate-500'}"></span>
                                    <span class="font-medium">${escapeHtml(asset.name)}</span>
                                </div>
                                <span class="font-extrabold text-slate-900">${asset.pct}%</span>
                            </div>
                        `;
                    }
                });

                card.innerHTML = `
                    <div class="flex items-center justify-between gap-2 mb-4">
                        <div>
                            <h4 class="font-bold text-sm text-slate-900">${escapeHtml(pf.author)}</h4>
                            <span class="text-[10px] text-finance-blue font-bold">${escapeHtml(pf.style)}</span>
                        </div>
                        <span class="text-[9px] text-slate-400 font-mono">${pf.date}</span>
                    </div>

                    <!-- Visual Integrated Bar Chart -->
                    <div class="w-full h-3 bg-slate-100 rounded-full overflow-hidden flex mb-4">
                        ${progressSegments}
                    </div>

                    <!-- Legend list -->
                    <div class="space-y-1.5">
                        ${legendList}
                    </div>

                    <!-- Delete button -->
                    <button onclick="deletePortfolio(${pf.id})" class="absolute right-3 top-3 p-1 rounded hover:bg-rose-50 text-slate-300 hover:text-finance-red opacity-0 group-hover:opacity-100 transition-all duration-200" title="지우기">
                        <i data-lucide="trash-2" class="w-4 h-4"></i>
                    </button>
                `;
                container.appendChild(card);
            });
            lucide.createIcons();
        }

        // Form registration trigger for creator
        document.getElementById('portfolio-creator-form').addEventListener('submit', function(e) {
            e.preventDefault();
            const author = document.getElementById('pf-author').value.trim();
            const style = document.getElementById('pf-style').value;
            
            const n1 = document.getElementById('pf-asset1-name').value.trim();
            const p1 = parseInt(document.getElementById('pf-asset1-pct').value) || 0;
            const n2 = document.getElementById('pf-asset2-name').value.trim();
            const p2 = parseInt(document.getElementById('pf-asset2-pct').value) || 0;
            const n3 = document.getElementById('pf-asset3-name').value.trim();
            const p3 = parseInt(document.getElementById('pf-asset3-pct').value) || 0;

            if (!author || !n1 || !n2 || !n3) {
                showToast("모든 빈칸을 채워주세요!");
                return;
            }

            if (p1 + p2 + p3 !== 100) {
                showToast(`비율의 합이 100%여야 합니다! 현재: ${p1 + p2 + p3}%`);
                return;
            }

            const list = getPortfolios();
            const now = new Date();
            const dateStr = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')} ${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;

            const newPf = {
                id: Date.now(),
                author,
                style,
                assets: [
                    { name: n1, pct: p1, color: "bg-rose-500" },
                    { name: n2, pct: p2, color: "bg-amber-500" },
                    { name: n3, pct: p3, color: "bg-emerald-500" }
                ],
                date: dateStr
            };

            list.push(newPf);
            localStorage.setItem('jubin_portfolios', JSON.stringify(list));
            
            this.reset();
            renderPortfolios();
            showToast("포트폴리오 생성 및 자랑 등록 성공! 🎉");
        });

        window.deletePortfolio = function(id) {
            let list = getPortfolios();
            list = list.filter(item => item.id !== id);
            localStorage.setItem('jubin_portfolios', JSON.stringify(list));
            renderPortfolios();
            showToast("성공적으로 포트폴리오를 삭제했습니다.");
        }

        // 5. Live LocalStorage Comment Share Feed (Original Chat board)
        const defaultComments = [
            { id: 1, author: '동치미개미', seed: '💰 100만 원 이하 (소액 개미)', favorite: '엔비디아 (NVDA)', content: '주빈이 파이팅! 나도 20살인데 시드 80만 원으로 AI 주식 모으고 있어. 복리 연 15% 가자!', date: '2026-06-02 12:44' },
            { id: 2, author: '배당금내놔', seed: '💵 100만 ~ 500만 원', favorite: '맥쿼리인프라', content: '20살에 주식 시작한 것 자체가 이미 또래 중 상위 1%다. 조급해하지 말고 배당 든든히 복리로 키워!', date: '2026-06-02 14:15' }
        ];

        function getFeedEntries() {
            const data = localStorage.getItem('jubin_stocks_feed');
            if (!data) {
                localStorage.setItem('jubin_stocks_feed', JSON.stringify(defaultComments));
                return defaultComments;
            }
            return JSON.parse(data);
        }

        function renderFeed() {
            const listEl = document.getElementById('share-feed-list');
            const countEl = document.getElementById('sb-count');
            const entries = getFeedEntries();
            
            listEl.innerHTML = '';
            countEl.textContent = `${entries.length}명`;

            if (entries.length === 0) {
                listEl.innerHTML = `<div class="text-center py-8 text-slate-400 text-xs">등록된 주주들의 현황이 아직 없어. 첫 주자가 되어줘!</div>`;
                return;
            }

            [...entries].reverse().forEach(entry => {
                const item = document.createElement('div');
                item.className = 'p-4 rounded-2xl border border-slate-100 bg-slate-50/50 hover:bg-slate-50 transition-all relative group';
                
                item.innerHTML = `
                    <div class="flex flex-wrap items-center justify-between gap-1 mb-2">
                        <div class="flex items-center gap-2">
                            <span class="font-bold text-xs text-slate-800">${escapeHtml(entry.author)}</span>
                            <span class="text-[9px] px-2 py-0.5 rounded-full font-bold bg-white border border-slate-100 text-slate-500">${entry.seed}</span>
                        </div>
                        <span class="text-[9px] text-slate-400 font-mono">${entry.date}</span>
                    </div>
                    <div class="flex items-center gap-1.5 text-[10px] font-bold text-finance-blue mb-1.5">
                        <i data-lucide="heart" class="w-3 h-3 fill-current"></i>
                        <span>최애 관심주: ${escapeHtml(entry.favorite)}</span>
                    </div>
                    <p class="text-[11px] text-slate-600 leading-normal pr-8">${escapeHtml(entry.content)}</p>
                    <button onclick="deleteFeedItem(${entry.id})" class="absolute right-3 bottom-3 p-1 rounded hover:bg-rose-50 text-slate-300 hover:text-finance-red opacity-0 group-hover:opacity-100 transition-all duration-200" title="지우기">
                        <i data-lucide="trash-2" class="w-3 h-3"></i>
                    </button>
                `;
                listEl.appendChild(item);
            });
            lucide.createIcons();
        }

        function escapeHtml(text) {
            const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
            return text.replace(/[&<>"']/g, m => map[m]);
        }

        // Form submit
        document.getElementById('stock-share-form').addEventListener('submit', function(e) {
            e.preventDefault();
            const author = document.getElementById('sb-author').value.trim();
            const seed = document.getElementById('sb-seed').value;
            const favorite = document.getElementById('sb-favorite').value.trim();
            const content = document.getElementById('sb-content').value.trim();

            if (!author || !favorite || !content) {
                showToast("빈칸을 모두 채워주세요!");
                return;
            }

            const entries = getFeedEntries();
            const now = new Date();
            const dateStr = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')} ${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;

            const newEntry = {
                id: Date.now(),
                author,
                seed,
                favorite,
                content,
                date: dateStr
            };

            entries.push(newEntry);
            localStorage.setItem('jubin_stocks_feed', JSON.stringify(entries));
            
            this.reset();
            renderFeed();
            showToast("주주 피드 등록 완료! 📈");
        });

        window.deleteFeedItem = function(id) {
            let entries = getFeedEntries();
            entries = entries.filter(e => e.id !== id);
            localStorage.setItem('jubin_stocks_feed', JSON.stringify(entries));
            renderFeed();
            showToast("의견이 무사히 삭제되었습니다.");
        }

        // Initial launch actions
        window.onload = function() {
            renderPortfolios();
            renderFeed();
            lucide.createIcons();
        }
    </script>
</body>
</html>
